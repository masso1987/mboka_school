# --- API ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Runtime connection: the non-owner application role. Row-Level Security applies to it.
DATABASE_URL=postgresql://mboka_app:mboka_app_dev@localhost:5432/mboka?schema=public
# Migrations and seeding: the schema owner role (bypasses RLS). Never used by the running API.
DIRECT_DATABASE_URL=postgresql://mboka:mboka_dev@localhost:5432/mboka?schema=public
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=12
# Seed: initial platform super administrator (change before any shared environment).
SEED_ADMIN_EMAIL=admin@mboka.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
# Demo school director (development only; not created when NODE_ENV=production).
SEED_DEMO_PASSWORD=Demo!2026

# 32 random bytes, base64. Encrypts secrets at rest (payment-provider credentials, MFA seeds).
# Generate one per environment and keep it in the secret store; losing it locks every MFA user out:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (PAYMENT_SECRETS_KEY is still read when APP_SECRETS_KEY is unset.)
APP_SECRETS_KEY=

# --- Operations --------------------------------------------------------
# Requests per client per minute on every route; login has its own LOGIN_RATE_LIMIT.
RATE_LIMIT_PER_MINUTE=300
# Queries slower than this (ms) are logged with their SQL text, never their parameters.
SLOW_QUERY_MS=500
# Bearer token for GET /api/v1/health/metrics (Prometheus). Unset = endpoint disabled (404).
METRICS_TOKEN=
# One JSON access-log line per request; set to off to silence (tests).
ACCESS_LOG=on

# --- Mobile Money (MTN MoMo, Orange Money) -------------------------------
# Public address of this API, used in the operators' callback URLs.
PUBLIC_URL=http://localhost:3000
# Seconds between checks of pending operator payments; 0 disables (tests).
MOBILE_MONEY_POLL_SECONDS=60
# Operator API hosts the schools may configure (production refuses any other host).
MOBILE_MONEY_ALLOWED_HOSTS=sandbox.momodeveloper.mtn.com,proxy.momoapi.mtn.com,api.orange.com
