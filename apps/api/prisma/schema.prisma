// Mboka School System — Phase 0 foundation schema.
// Conventions (spec §6.5): UUID keys, timestamptz in UTC, DATE for calendar dates,
// snake_case tables/columns, tenant_id on every tenant-owned table.
// Tenant isolation: see docs/adr/0001-tenant-isolation.md. RLS policies live in
// the hand-written migration 0002_rls — re-check them whenever a tenant table is added.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------- platform

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model Tenant {
  id              String       @id @default(uuid()) @db.Uuid
  slug            String       @unique
  legalName       String       @map("legal_name")
  tradingName     String?      @map("trading_name")
  status          TenantStatus @default(ACTIVE)
  defaultLocale   String       @default("fr") @map("default_locale")
  timezone        String       @default("Africa/Douala")
  defaultCurrency String       @default("XAF") @map("default_currency") @db.Char(3)
  /// Free-form school settings (branding, formats…) until each gets a typed home.
  settings        Json         @default("{}")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  campuses      Campus[]
  memberships   Membership[]
  roles         Role[]
  academicYears AcademicYear[]
  subscription  Subscription?

  @@map("tenants")
}

model Subscription {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @unique @map("tenant_id") @db.Uuid
  plan         String    @default("starter")
  maxCampuses  Int       @default(1) @map("max_campuses")
  maxUsers     Int       @default(50) @map("max_users")
  modules      String[]  @default([])
  currentUntil DateTime? @map("current_until") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

// ---------------------------------------------------------------- identity

enum PlatformRole {
  NONE
  SUPER_ADMIN
  SUPPORT
}

model User {
  id                String       @id @default(uuid()) @db.Uuid
  email             String       @unique
  fullName          String       @map("full_name")
  passwordHash      String?      @map("password_hash")
  locale            String?
  platformRole      PlatformRole @default(NONE) @map("platform_role")
  /// TOTP secret, AES-256-GCM encrypted (APP_SECRETS_KEY). Set once enrollment is confirmed.
  mfaSecret         String?      @map("mfa_secret")
  /// Secret being enrolled, until the first valid code confirms it.
  mfaPendingSecret  String?      @map("mfa_pending_secret")
  mfaEnabledAt      DateTime?    @map("mfa_enabled_at") @db.Timestamptz(6)
  /// SHA-256 of each unused single-use recovery code.
  mfaRecoveryCodes  String[]     @default([]) @map("mfa_recovery_codes")
  /// Last accepted TOTP time step: a code is never accepted twice.
  mfaLastStep       Int?         @map("mfa_last_step")
  passwordChangedAt DateTime?    @map("password_changed_at") @db.Timestamptz(6)
  isActive          Boolean      @default(true) @map("is_active")
  lastLoginAt       DateTime?    @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions    Session[]
  memberships Membership[]

  @@map("users")
}

/// Server-managed session. Only the SHA-256 of the token is stored.
model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  csrfToken   String    @map("csrf_token")
  ip          String?
  userAgent   String?   @map("user_agent")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// False until the second factor is presented, for accounts with MFA.
  mfaVerified Boolean   @default(true) @map("mfa_verified")
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REVOKED
}

/// Explicit authorization of a user inside one tenant (spec §6.3).
model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments UserRoleAssignment[]
  staff       Staff?

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
  @@map("user_tenant_memberships")
}

/// Global permission catalogue, synchronised from @mboka/shared at seed time.
model Permission {
  key         String @id
  description String

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  nameFr    String   @map("name_fr")
  nameEn    String   @map("name_en")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("roles")
}

model RolePermission {
  tenantId      String @map("tenant_id") @db.Uuid
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([tenantId])
  @@map("role_permissions")
}

/// Composite keys (tenant_id, …) make a cross-tenant role assignment impossible at the database level.
model UserRoleAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  /// Optional contextual restriction (campus); null means tenant-wide.
  campusId     String?  @map("campus_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@unique([membershipId, roleId, campusId])
  @@index([tenantId])
  @@map("user_role_assignments")
}

// ---------------------------------------------------------------- school

model Campus {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  classes SchoolClass[]
  rooms   Room[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("campuses")
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  CLOSED
}

/// First tenant-scoped business entity; overlap is prevented by an exclusion constraint (migration 0002).
model AcademicYear {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  name      String
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  status    AcademicYearStatus @default(DRAFT)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?            @map("created_by") @db.Uuid

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  periods          AcademicPeriod[]
  classes          SchoolClass[]
  enrollments      Enrollment[]
  admissions       Admission[]
  assignments      TeachingAssignment[]
  timetableEntries TimetableEntry[]
  feeSchedules     FeeSchedule[]
  invoices         Invoice[]
  budgets          Budget[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("academic_years")
}

// ---------------------------------------------------------------- audit

/// Append-only: the application role has no UPDATE/DELETE grant on this table (migration 0002).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

// ================================================================ Phase 1
// New tenant tables carry tenant_id with an FK to tenants added in migration 0003
// (no Prisma back-relation on Tenant, to keep that model readable). Required references
// to other tenant tables are composite (tenant_id, id); optional ones also get a composite
// FK in raw SQL (0003), since Prisma cannot mix optional and required columns in a relation.

/// Per-tenant monotonic counters (matricules, staff numbers), incremented with UPDATE … RETURNING.
model TenantCounter {
  tenantId String @map("tenant_id") @db.Uuid
  key      String
  value    Int    @default(0)

  @@id([tenantId, key])
  @@map("tenant_counters")
}

/// Client-generated operation ids already applied (offline replay protection, ATT-009/010).
model SyncOperation {
  tenantId    String   @map("tenant_id") @db.Uuid
  operationId String   @map("operation_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  kind        String
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([tenantId, operationId])
  @@map("sync_operations")
}

// ---------------------------------------------------------------- academics

enum PeriodKind {
  TERM
  SEMESTER
  SEQUENCE
  EXAM_SESSION
  OTHER
}

model AcademicPeriod {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  academicYearId String     @map("academic_year_id") @db.Uuid
  kind           PeriodKind
  name           String
  position       Int
  startDate      DateTime   @map("start_date") @db.Date
  endDate        DateTime   @map("end_date") @db.Date
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  academicYear AcademicYear      @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  assessments  Assessment[]
  submissions  GradeSubmission[]

  @@unique([tenantId, academicYearId, kind, position])
  @@unique([tenantId, id])
  @@map("academic_periods")
}

enum EducationCycle {
  PRIMARY
  SECONDARY_FIRST
  SECONDARY_SECOND
  TECHNICAL
  VOCATIONAL
}

model EducationLevel {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  code      String
  nameFr    String         @map("name_fr")
  nameEn    String         @map("name_en")
  cycle     EducationCycle
  position  Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  classes    SchoolClass[]
  admissions Admission[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("education_levels")
}

/// Streams, series and technical specializations (ACA-004/009).
model Program {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  nameFr    String   @map("name_fr")
  nameEn    String   @map("name_en")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  classes SchoolClass[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("programs")
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  nameFr    String   @map("name_fr")
  nameEn    String   @map("name_en")
  category  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  classSubjects ClassSubject[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("subjects")
}

/// A class (or section/group) within one academic year.
model SchoolClass {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  campusId       String   @map("campus_id") @db.Uuid
  levelId        String   @map("level_id") @db.Uuid
  programId      String?  @map("program_id") @db.Uuid
  code           String
  name           String
  capacity       Int?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  academicYear     AcademicYear        @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  campus           Campus              @relation(fields: [tenantId, campusId], references: [tenantId, id], onDelete: Restrict)
  level            EducationLevel      @relation(fields: [tenantId, levelId], references: [tenantId, id], onDelete: Restrict)
  program          Program?            @relation(fields: [programId], references: [id], onDelete: Restrict)
  subjects         ClassSubject[]
  enrollments      Enrollment[]
  attendance       AttendanceSession[]
  timetableEntries TimetableEntry[]

  @@unique([tenantId, academicYearId, code])
  @@unique([tenantId, id])
  @@map("classes")
}

/// Subject taught in a class with its coefficient — distinct from assessment weights (Module 7 formula note).
model ClassSubject {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  classId     String   @map("class_id") @db.Uuid
  subjectId   String   @map("subject_id") @db.Uuid
  coefficient Decimal  @db.Decimal(5, 2)
  weeklyHours Decimal  @map("weekly_hours") @db.Decimal(4, 1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  schoolClass SchoolClass          @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict)
  subject     Subject              @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Restrict)
  assignments TeachingAssignment[]
  assessments Assessment[]
  submissions GradeSubmission[]

  @@unique([tenantId, classId, subjectId])
  @@unique([tenantId, id])
  @@map("class_subjects")
}

// ---------------------------------------------------------------- staff

enum EmploymentType {
  PERMANENT
  CONTRACT
  PART_TIME
  TEMPORARY
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

model Staff {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  /// Linked user account in this tenant, when the employee signs in (teachers).
  membershipId   String?        @unique @map("membership_id") @db.Uuid
  staffNumber    String         @map("staff_number")
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  gender         String?
  email          String?
  phone          String?
  position       String
  isTeacher      Boolean        @default(false) @map("is_teacher")
  employmentType EmploymentType @map("employment_type")
  status         StaffStatus    @default(ACTIVE)
  hireDate       DateTime?      @map("hire_date") @db.Date
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership       Membership?          @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  assignments      TeachingAssignment[]
  timetableEntries TimetableEntry[]

  contracts     EmploymentContract[]
  compensations Compensation[]
  leaves        LeaveRequest[]
  entitlements  LeaveEntitlement[]

  @@unique([tenantId, staffNumber])
  @@unique([tenantId, id])
  @@map("staff")
}

enum AssignmentRole {
  MAIN
  CO_TEACHER
  REPLACEMENT
}

/// Never deleted: ending an assignment sets end_date so teaching history is preserved (Module 4).
model TeachingAssignment {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  academicYearId String         @map("academic_year_id") @db.Uuid
  classSubjectId String         @map("class_subject_id") @db.Uuid
  staffId        String         @map("staff_id") @db.Uuid
  role           AssignmentRole @default(MAIN)
  startDate      DateTime       @map("start_date") @db.Date
  endDate        DateTime?      @map("end_date") @db.Date
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  classSubject ClassSubject @relation(fields: [tenantId, classSubjectId], references: [tenantId, id], onDelete: Restrict)
  staff        Staff        @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, staffId])
  @@map("teaching_assignments")
}

// ---------------------------------------------------------------- students

enum StudentStatus {
  APPLICANT
  ACTIVE
  GRADUATED
  WITHDRAWN
  TRANSFERRED
  ARCHIVED
}

model Student {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  matricule    String
  firstName    String        @map("first_name")
  lastName     String        @map("last_name")
  gender       String?
  dateOfBirth  DateTime      @map("date_of_birth") @db.Date
  placeOfBirth String?       @map("place_of_birth")
  nationality  String?
  address      String?
  /// Student portal account in this school (Phase 4).
  membershipId String?       @unique @map("membership_id") @db.Uuid
  status       StudentStatus @default(ACTIVE)
  archivedAt   DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  guardians   StudentGuardian[]
  enrollments Enrollment[]
  admissions  Admission[]
  attendance  AttendanceRecord[]
  invoices    Invoice[]
  payments    Payment[]

  @@unique([tenantId, matricule])
  @@unique([tenantId, id])
  @@index([tenantId, lastName, firstName])
  @@map("students")
}

model Guardian {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  phone        String?
  email        String?
  address      String?
  /// Parent portal account in this school (Phase 4).
  membershipId String?  @unique @map("membership_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  students StudentGuardian[]

  @@unique([tenantId, id])
  @@index([tenantId, phone])
  @@map("guardians")
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  SIBLING
  OTHER
}

model StudentGuardian {
  tenantId           String               @map("tenant_id") @db.Uuid
  studentId          String               @map("student_id") @db.Uuid
  guardianId         String               @map("guardian_id") @db.Uuid
  relationship       GuardianRelationship
  isPrimary          Boolean              @default(false) @map("is_primary")
  isEmergencyContact Boolean              @default(false) @map("is_emergency_contact")
  canPickUp          Boolean              @default(false) @map("can_pick_up")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  student  Student  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)
  guardian Guardian @relation(fields: [tenantId, guardianId], references: [tenantId, id], onDelete: Restrict)

  @@id([studentId, guardianId])
  @@index([tenantId, guardianId])
  @@map("student_guardians")
}

enum AdmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WAITLISTED
  WITHDRAWN
}

model Admission {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  studentId        String          @map("student_id") @db.Uuid
  academicYearId   String          @map("academic_year_id") @db.Uuid
  requestedLevelId String          @map("requested_level_id") @db.Uuid
  status           AdmissionStatus @default(SUBMITTED)
  notes            String?
  decidedAt        DateTime?       @map("decided_at") @db.Timestamptz(6)
  decidedBy        String?         @map("decided_by") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  student        Student        @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  academicYear   AcademicYear   @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  requestedLevel EducationLevel @relation(fields: [tenantId, requestedLevelId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("admissions")
}

enum EnrollmentStatus {
  PENDING
  ENROLLED
  REPEATING
  TRANSFERRED
  WITHDRAWN
  COMPLETED
}

/// At most one active enrollment per student and academic year (partial unique index in 0003).
model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  classId        String           @map("class_id") @db.Uuid
  status         EnrollmentStatus @default(ENROLLED)
  enrolledOn     DateTime         @map("enrolled_on") @db.Date
  leftOn         DateTime?        @map("left_on") @db.Date
  leftReason     String?          @map("left_reason")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  student      Student            @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  academicYear AcademicYear       @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  schoolClass  SchoolClass        @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict)
  attendance   AttendanceRecord[]
  marks        StudentMark[]
  reportCards  ReportCard[]
  promotion    PromotionDecision?

  @@unique([tenantId, id])
  @@index([tenantId, classId])
  @@map("enrollments")
}

// ---------------------------------------------------------------- attendance

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// One register per class, date and slot ("DAY" for daily attendance, or a lesson label).
model AttendanceSession {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  date      DateTime @db.Date
  slot      String   @default("DAY")
  version   Int      @default(1)
  takenBy   String   @map("taken_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  schoolClass SchoolClass        @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict)
  records     AttendanceRecord[]

  @@unique([tenantId, classId, date, slot])
  @@unique([tenantId, id])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  sessionId    String           @map("session_id") @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  enrollmentId String           @map("enrollment_id") @db.Uuid
  status       AttendanceStatus
  arrivalTime  String?          @map("arrival_time")
  reason       String?
  updatedBy    String           @map("updated_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  session    AttendanceSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade)
  student    Student           @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  enrollment Enrollment        @relation(fields: [tenantId, enrollmentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, sessionId, studentId])
  @@index([tenantId, studentId])
  @@map("attendance_records")
}

// ---------------------------------------------------------------- timetable

model Room {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  campusId  String   @map("campus_id") @db.Uuid
  code      String
  name      String
  capacity  Int?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  campus           Campus           @relation(fields: [tenantId, campusId], references: [tenantId, id], onDelete: Restrict)
  timetableEntries TimetableEntry[]

  @@unique([tenantId, campusId, code])
  @@unique([tenantId, id])
  @@map("rooms")
}

/// Weekly lesson slot. Teacher, room and class double-booking is rejected by exclusion constraints (0003).
model TimetableEntry {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  subjectLabel   String   @map("subject_label")
  staffId        String?  @map("staff_id") @db.Uuid
  roomId         String?  @map("room_id") @db.Uuid
  /// ISO weekday, 1 = Monday.
  weekday        Int
  /// Minutes since midnight, school-local time.
  startMinute    Int      @map("start_minute")
  endMinute      Int      @map("end_minute")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  schoolClass  SchoolClass  @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict)
  staff        Staff?       @relation(fields: [staffId], references: [id], onDelete: Restrict)
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("timetable_entries")
}

// ================================================================ Phase 3 — finance
// Money: NUMERIC(18,2) with the ISO 4217 code beside every amount; decimals beyond the
// currency's minor units (XAF: 0) are rejected by the API. Rates: NUMERIC(20,10), always read
// as "1 <base> = <rate> <quote>". Posted rows (payments, allocations, receipts, rates, provider
// events) are append-only for the runtime role (grants in 0004); corrections are new rows.

/// ISO 4217 reference data (global, not tenant-owned).
model Currency {
  code       String @id @db.Char(3)
  minorUnits Int    @map("minor_units")
  nameFr     String @map("name_fr")
  nameEn     String @map("name_en")

  @@map("currencies")
}

model FinanceSettings {
  tenantId                 String   @id @map("tenant_id") @db.Uuid
  reportingCurrency        String   @map("reporting_currency") @db.Char(3)
  enabledCurrencies        String[] @map("enabled_currencies")
  /// Expenses above this amount (reporting currency) need `expenses.approve.unlimited` (EXP-004).
  expenseApprovalThreshold Decimal  @map("expense_approval_threshold") @db.Decimal(18, 2)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("finance_settings")
}

/// Append-only rate history. "1 base = rate quote" from effective_date until the next rate (CUR-005/006/011).
model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  baseCurrency  String   @map("base_currency") @db.Char(3)
  quoteCurrency String   @map("quote_currency") @db.Char(3)
  rate          Decimal  @db.Decimal(20, 10)
  effectiveDate DateTime @map("effective_date") @db.Date
  source        String   @default("MANUAL")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, baseCurrency, quoteCurrency, effectiveDate])
  @@map("exchange_rates")
}

enum FinancialPeriodStatus {
  OPEN
  CLOSED
}

/// Transactions dated inside a closed period are refused; corrections post in an open period.
model FinancialPeriod {
  id        String                @id @default(uuid()) @db.Uuid
  tenantId  String                @map("tenant_id") @db.Uuid
  name      String
  startDate DateTime              @map("start_date") @db.Date
  endDate   DateTime              @map("end_date") @db.Date
  status    FinancialPeriodStatus @default(OPEN)
  closedAt  DateTime?             @map("closed_at") @db.Timestamptz(6)
  closedBy  String?               @map("closed_by") @db.Uuid
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@map("financial_periods")
}

// ---------------------------------------------------------------- billing

enum FeeKind {
  REGISTRATION
  TUITION
  EXAM
  TRANSPORT
  CANTEEN
  UNIFORM
  OTHER
}

model FeeCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  nameFr    String   @map("name_fr")
  nameEn    String   @map("name_en")
  kind      FeeKind
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  schedules FeeSchedule[]
  lines     InvoiceLine[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("fee_categories")
}

/// A fee for one academic year, optionally limited to a level or a class, payable in installments (FIN-001/003).
model FeeSchedule {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  name           String
  currency       String   @db.Char(3)
  amount         Decimal  @db.Decimal(18, 2)
  levelId        String?  @map("level_id") @db.Uuid
  classId        String?  @map("class_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  academicYear AcademicYear           @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  category     FeeCategory            @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  installments FeeInstallment[]
  assignments  StudentFeeAssignment[]

  @@unique([tenantId, id])
  @@map("fee_schedules")
}

model FeeInstallment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  scheduleId String   @map("schedule_id") @db.Uuid
  position   Int
  label      String
  dueDate    DateTime @map("due_date") @db.Date
  amount     Decimal  @db.Decimal(18, 2)

  schedule FeeSchedule @relation(fields: [tenantId, scheduleId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, scheduleId, position])
  @@map("fee_installments")
}

/// Records that a schedule was billed to an enrollment — makes re-applying a schedule a no-op.
model StudentFeeAssignment {
  tenantId     String   @map("tenant_id") @db.Uuid
  scheduleId   String   @map("schedule_id") @db.Uuid
  enrollmentId String   @map("enrollment_id") @db.Uuid
  invoiceId    String   @map("invoice_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  schedule FeeSchedule @relation(fields: [tenantId, scheduleId], references: [tenantId, id], onDelete: Restrict)
  invoice  Invoice     @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)

  @@id([scheduleId, enrollmentId])
  @@index([tenantId])
  @@map("student_fee_assignments")
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

model Invoice {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  number            String
  studentId         String        @map("student_id") @db.Uuid
  academicYearId    String        @map("academic_year_id") @db.Uuid
  enrollmentId      String?       @map("enrollment_id") @db.Uuid
  currency          String        @db.Char(3)
  issueDate         DateTime      @map("issue_date") @db.Date
  status            InvoiceStatus @default(ISSUED)
  /// Invoice→reporting currency rate at issue, for realized exchange differences (CUR-009).
  reportingCurrency String        @map("reporting_currency") @db.Char(3)
  reportingRate     Decimal       @map("reporting_rate") @db.Decimal(20, 10)
  notes             String?
  cancelledReason   String?       @map("cancelled_reason")
  createdBy         String        @map("created_by") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  student      Student                @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  academicYear AcademicYear           @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  lines        InvoiceLine[]
  allocations  PaymentAllocation[]
  assignments  StudentFeeAssignment[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, studentId])
  @@map("invoices")
}

enum InvoiceLineKind {
  CHARGE
  DISCOUNT
}

enum DiscountKind {
  DISCOUNT
  SCHOLARSHIP
  WAIVER
}

/// Charges and approved reductions; amounts are positive, DISCOUNT lines subtract (FIN-004).
model InvoiceLine {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  invoiceId     String          @map("invoice_id") @db.Uuid
  kind          InvoiceLineKind
  categoryId    String?         @map("category_id") @db.Uuid
  description   String
  amount        Decimal         @db.Decimal(18, 2)
  dueDate       DateTime?       @map("due_date") @db.Date
  installmentId String?         @map("installment_id") @db.Uuid
  discountKind  DiscountKind?   @map("discount_kind")
  reason        String?
  createdBy     String          @map("created_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice  Invoice      @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)
  category FeeCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([tenantId, invoiceId])
  @@map("invoice_lines")
}

// ---------------------------------------------------------------- payments

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOBILE_MONEY
  CHEQUE
}

enum PaymentStatus {
  PENDING_VERIFICATION
  CONFIRMED
  FAILED
  REVERSED
}

/// Immutable once confirmed: only status moves (→ REVERSED) with reversal metadata (FIN-013/017).
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  studentId         String        @map("student_id") @db.Uuid
  method            PaymentMethod
  currency          String        @db.Char(3)
  amount            Decimal       @db.Decimal(18, 2)
  receivedOn        DateTime      @map("received_on") @db.Date
  status            PaymentStatus
  externalReference String?       @map("external_reference")
  provider          String?
  /// Mobile Money number the operator was asked to debit.
  payerMsisdn       String?       @map("payer_msisdn")
  /// Operator handles needed to check the result (e.g. Orange pay/notif tokens). Never credentials.
  providerState     Json?         @map("provider_state")
  providerCheckedAt DateTime?     @map("provider_checked_at") @db.Timestamptz(6)
  failureReason     String?       @map("failure_reason")
  idempotencyKey    String        @map("idempotency_key") @db.Uuid
  cashierSessionId  String?       @map("cashier_session_id") @db.Uuid
  recordedBy        String?       @map("recorded_by") @db.Uuid
  /// Payment→reporting conversion snapshot at the payment date (CUR-006/008).
  reportingCurrency String        @map("reporting_currency") @db.Char(3)
  reportingRate     Decimal       @map("reporting_rate") @db.Decimal(20, 10)
  reportingAmount   Decimal       @map("reporting_amount") @db.Decimal(18, 2)
  notes             String?
  confirmedAt       DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  reversedAt        DateTime?     @map("reversed_at") @db.Timestamptz(6)
  reversedBy        String?       @map("reversed_by") @db.Uuid
  reversalReason    String?       @map("reversal_reason")
  /// Accounting date of the reversal entry (an open period), distinct from the original receivedOn.
  reversalDate      DateTime?     @map("reversal_date") @db.Date
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  student     Student             @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  allocations PaymentAllocation[]
  receipt     Receipt?
  refunds     Refund[]

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, id])
  @@index([tenantId, studentId])
  @@index([tenantId, receivedOn])
  @@map("payments")
}

/// Part of a payment applied to an invoice, with the conversion used when currencies differ (FIN-011, CUR-004).
model PaymentAllocation {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  paymentId          String   @map("payment_id") @db.Uuid
  invoiceId          String   @map("invoice_id") @db.Uuid
  amount             Decimal  @db.Decimal(18, 2)
  invoiceAmount      Decimal  @map("invoice_amount") @db.Decimal(18, 2)
  /// "1 payment currency = rate invoice currency" (1 when equal).
  rate               Decimal  @db.Decimal(20, 10)
  /// Realized difference in reporting currency between the invoice's and the payment's rates.
  exchangeDifference Decimal  @default(0) @map("exchange_difference") @db.Decimal(18, 2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)
  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, invoiceId])
  @@index([tenantId, paymentId])
  @@map("payment_allocations")
}

model Receipt {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  number    String
  paymentId String   @unique @map("payment_id") @db.Uuid
  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedBy  String?  @map("issued_by") @db.Uuid

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, number])
  @@map("receipts")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
}

/// Refund of a payment's unallocated credit. The approver must differ from the requester (§3.3).
model Refund {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  paymentId    String       @map("payment_id") @db.Uuid
  amount       Decimal      @db.Decimal(18, 2)
  reason       String
  status       RefundStatus @default(REQUESTED)
  requestedBy  String       @map("requested_by") @db.Uuid
  decidedBy    String?      @map("decided_by") @db.Uuid
  decidedAt    DateTime?    @map("decided_at") @db.Timestamptz(6)
  decisionNote String?      @map("decision_note")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, paymentId])
  @@map("refunds")
}

/// Per-school provider credentials; the HMAC secret is stored encrypted (AES-256-GCM, PAYMENT_SECRETS_KEY).
model PaymentProvider {
  tenantId        String   @map("tenant_id") @db.Uuid
  code            String
  /// SIGNED_WEBHOOK | MTN_MOMO | ORANGE_MONEY (check constraint in migration 0009).
  kind            String   @default("SIGNED_WEBHOOK")
  /// Signing secret, or the operator credentials as encrypted JSON.
  secretEncrypted String   @map("secret_encrypted")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([tenantId, code])
  @@map("payment_providers")
}

/// Every authenticated provider callback, once per (transaction, status): replays are no-ops (FIN-009/010).
model PaymentProviderEvent {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  provider       String
  providerTxId   String   @map("provider_tx_id")
  providerStatus String   @map("provider_status")
  payload        Json
  paymentId      String?  @map("payment_id") @db.Uuid
  outcome        String
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([tenantId, provider, providerTxId, providerStatus])
  @@map("payment_provider_events")
}

enum CashierSessionStatus {
  OPEN
  CLOSED
}

/// A cashier's till for one currency; closing compares counted cash with recorded cash (FIN-014).
model CashierSession {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  cashierId      String               @map("cashier_id") @db.Uuid
  currency       String               @db.Char(3)
  openingFloat   Decimal              @map("opening_float") @db.Decimal(18, 2)
  openedAt       DateTime             @default(now()) @map("opened_at") @db.Timestamptz(6)
  status         CashierSessionStatus @default(OPEN)
  closedAt       DateTime?            @map("closed_at") @db.Timestamptz(6)
  expectedAmount Decimal?             @map("expected_amount") @db.Decimal(18, 2)
  countedAmount  Decimal?             @map("counted_amount") @db.Decimal(18, 2)
  discrepancy    Decimal?             @db.Decimal(18, 2)
  notes          String?

  @@unique([tenantId, id])
  @@map("cashier_sessions")
}

// ---------------------------------------------------------------- expenses and budgets

model ExpenseCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  nameFr    String   @map("name_fr")
  nameEn    String   @map("name_en")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  expenses    Expense[]
  budgetLines BudgetLine[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("expense_categories")
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

model Expense {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  number           String
  categoryId       String        @map("category_id") @db.Uuid
  supplier         String?
  description      String
  amount           Decimal       @db.Decimal(18, 2)
  currency         String        @db.Char(3)
  expenseDate      DateTime      @map("expense_date") @db.Date
  status           ExpenseStatus @default(SUBMITTED)
  reportingAmount  Decimal       @map("reporting_amount") @db.Decimal(18, 2)
  reportingRate    Decimal       @map("reporting_rate") @db.Decimal(20, 10)
  submittedBy      String        @map("submitted_by") @db.Uuid
  approvedBy       String?       @map("approved_by") @db.Uuid
  approvedAt       DateTime?     @map("approved_at") @db.Timestamptz(6)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)
  paymentReference String?       @map("payment_reference")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  category ExpenseCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  events   ExpenseEvent[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, expenseDate])
  @@map("expenses")
}

/// Approval history (EXP-003, `expense_approvals` in the spec): one row per status change.
model ExpenseEvent {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  expenseId  String         @map("expense_id") @db.Uuid
  fromStatus ExpenseStatus? @map("from_status")
  toStatus   ExpenseStatus  @map("to_status")
  actorId    String         @map("actor_id") @db.Uuid
  comment    String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  expense Expense @relation(fields: [tenantId, expenseId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, expenseId])
  @@map("expense_events")
}

model Budget {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  name           String
  currency       String   @db.Char(3)
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  lines        BudgetLine[]

  @@unique([tenantId, academicYearId])
  @@unique([tenantId, id])
  @@map("budgets")
}

model BudgetLine {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  budgetId   String  @map("budget_id") @db.Uuid
  categoryId String  @map("category_id") @db.Uuid
  amount     Decimal @db.Decimal(18, 2)

  budget   Budget          @relation(fields: [tenantId, budgetId], references: [tenantId, id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, budgetId, categoryId])
  @@map("budget_lines")
}

// ================================================================ Phase 2 — assessments and report cards
// Rules are versioned: a report card references the exact rule version that produced it, and its
// content is stored as a snapshot, so a published card stays reproducible after rules change (GRD-013).

/// The grading policy of a school; `currentVersion` points at the rules used for new computations.
model GradingScheme {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String
  isDefault      Boolean  @default(false) @map("is_default")
  currentVersion Int      @default(1) @map("current_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  versions GradingSchemeVersion[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("grading_schemes")
}

/// Immutable snapshot of a scheme version (insert-only for the runtime role).
model GradingSchemeVersion {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  schemeId  String   @map("scheme_id") @db.Uuid
  version   Int
  rules     Json
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  scheme      GradingScheme @relation(fields: [tenantId, schemeId], references: [tenantId, id], onDelete: Restrict)
  reportCards ReportCard[]

  @@unique([tenantId, schemeId, version])
  @@unique([tenantId, id])
  @@map("grading_scheme_versions")
}

enum AssessmentKind {
  TEST
  EXAM
  ASSIGNMENT
  PRACTICAL
  ORAL
}

/// A marked piece of work in one class subject and period, with its own maximum and weight (GRD-001/002).
model Assessment {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  classSubjectId String         @map("class_subject_id") @db.Uuid
  periodId       String         @map("period_id") @db.Uuid
  name           String
  kind           AssessmentKind
  maxScore       Decimal        @map("max_score") @db.Decimal(6, 2)
  weight         Decimal        @db.Decimal(6, 2)
  heldOn         DateTime?      @map("held_on") @db.Date
  createdBy      String         @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  classSubject ClassSubject   @relation(fields: [tenantId, classSubjectId], references: [tenantId, id], onDelete: Restrict)
  period       AcademicPeriod @relation(fields: [tenantId, periodId], references: [tenantId, id], onDelete: Restrict)
  marks        StudentMark[]

  @@unique([tenantId, id])
  @@index([tenantId, classSubjectId, periodId])
  @@map("assessments")
}

enum SubmissionStatus {
  OPEN
  SUBMITTED
  APPROVED
  REOPENED
}

/// Workflow state of one subject and period: entry, submitted, approved, possibly reopened.
model GradeSubmission {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  classSubjectId String           @map("class_subject_id") @db.Uuid
  periodId       String           @map("period_id") @db.Uuid
  status         SubmissionStatus @default(OPEN)
  submittedBy    String?          @map("submitted_by") @db.Uuid
  submittedAt    DateTime?        @map("submitted_at") @db.Timestamptz(6)
  approvedBy     String?          @map("approved_by") @db.Uuid
  approvedAt     DateTime?        @map("approved_at") @db.Timestamptz(6)
  reopenedBy     String?          @map("reopened_by") @db.Uuid
  reopenedAt     DateTime?        @map("reopened_at") @db.Timestamptz(6)
  reopenReason   String?          @map("reopen_reason")
  /// Set once approved: later mark changes are recorded in grade_change_history.
  everApproved   Boolean          @default(false) @map("ever_approved")
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  classSubject ClassSubject   @relation(fields: [tenantId, classSubjectId], references: [tenantId, id], onDelete: Restrict)
  period       AcademicPeriod @relation(fields: [tenantId, periodId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, classSubjectId, periodId])
  @@map("grade_submissions")
}

enum MarkStatus {
  PRESENT
  ABSENT
  EXCUSED
  EXEMPT
  NOT_ASSESSED
}

model StudentMark {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  assessmentId String     @map("assessment_id") @db.Uuid
  enrollmentId String     @map("enrollment_id") @db.Uuid
  studentId    String     @map("student_id") @db.Uuid
  score        Decimal?   @db.Decimal(6, 2)
  status       MarkStatus
  updatedBy    String     @map("updated_by") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  assessment Assessment @relation(fields: [tenantId, assessmentId], references: [tenantId, id], onDelete: Restrict)
  enrollment Enrollment @relation(fields: [tenantId, enrollmentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, assessmentId, enrollmentId])
  @@index([tenantId, studentId])
  @@map("student_marks")
}

/// Who changed which mark after approval, when and why (GRD-012). Insert-only.
model GradeChange {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  assessmentId String      @map("assessment_id") @db.Uuid
  studentId    String      @map("student_id") @db.Uuid
  fromScore    Decimal?    @map("from_score") @db.Decimal(6, 2)
  fromStatus   MarkStatus? @map("from_status")
  toScore      Decimal?    @map("to_score") @db.Decimal(6, 2)
  toStatus     MarkStatus  @map("to_status")
  reason       String
  changedBy    String      @map("changed_by") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, assessmentId])
  @@map("grade_change_history")
}

/// Teacher appreciation for a student in a subject and period (GRD-008).
model SubjectComment {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  classSubjectId String   @map("class_subject_id") @db.Uuid
  periodId       String   @map("period_id") @db.Uuid
  enrollmentId   String   @map("enrollment_id") @db.Uuid
  comment        String
  updatedBy      String   @map("updated_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, classSubjectId, periodId, enrollmentId])
  @@map("subject_comments")
}

enum ReportCardStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

/// A generated report card. `content` is the full snapshot shown to families; regenerating creates a
/// new version and supersedes (never edits) the previous one (GRD-009/013, scenario 5 of section 13.2).
model ReportCard {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  enrollmentId     String           @map("enrollment_id") @db.Uuid
  studentId        String           @map("student_id") @db.Uuid
  classId          String           @map("class_id") @db.Uuid
  academicYearId   String           @map("academic_year_id") @db.Uuid
  /// A period id, or ANNUAL for the year-end card.
  scope            String
  version          Int
  status           ReportCardStatus @default(DRAFT)
  schemeVersionId  String           @map("scheme_version_id") @db.Uuid
  content          Json
  inputHash        String           @map("input_hash")
  verificationCode String           @unique @map("verification_code")
  generatedBy      String           @map("generated_by") @db.Uuid
  generatedAt      DateTime         @default(now()) @map("generated_at") @db.Timestamptz(6)
  publishedBy      String?          @map("published_by") @db.Uuid
  publishedAt      DateTime?        @map("published_at") @db.Timestamptz(6)

  enrollment    Enrollment           @relation(fields: [tenantId, enrollmentId], references: [tenantId, id], onDelete: Restrict)
  schemeVersion GradingSchemeVersion @relation(fields: [tenantId, schemeVersionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, enrollmentId, scope, version])
  @@index([tenantId, classId, scope])
  @@map("report_cards")
}

enum PromotionOutcome {
  PROMOTED
  REPEAT
  GRADUATED
  EXCLUDED
}

/// Class council decision for the year (GRD-010); the proposal comes from the annual average.
model PromotionDecision {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  enrollmentId   String           @map("enrollment_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  decision       PromotionOutcome
  proposed       PromotionOutcome
  annualAverage  String?          @map("annual_average")
  note           String?
  decidedBy      String           @map("decided_by") @db.Uuid
  decidedAt      DateTime         @default(now()) @map("decided_at") @db.Timestamptz(6)

  enrollment Enrollment @relation(fields: [tenantId, enrollmentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, enrollmentId])
  @@map("promotion_decisions")
}

// ================================================================ Phase 4 — HR, communication, portals

/// Employment contracts; history is kept, a renewal is a new row (HR-003, contract-expiry alerts HR-010).
model EmploymentContract {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  staffId   String         @map("staff_id") @db.Uuid
  type      EmploymentType
  position  String
  startDate DateTime       @map("start_date") @db.Date
  endDate   DateTime?      @map("end_date") @db.Date
  notes     String?
  createdBy String         @map("created_by") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  staff Staff @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, staffId])
  @@map("employment_contracts")
}

/// Compensation history (HR-007). Confidential: readable only with hr.compensation.read. Insert-only.
model Compensation {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  staffId       String   @map("staff_id") @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Date
  currency      String   @db.Char(3)
  baseSalary    Decimal  @map("base_salary") @db.Decimal(18, 2)
  /// [{ label, amount }] monthly allowances.
  allowances    Json     @default("[]")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  staff Staff @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, staffId])
  @@map("compensations")
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

enum LeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

/// Leave and permission requests with an approval history (HR-005/006).
model LeaveRequest {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  staffId      String      @map("staff_id") @db.Uuid
  type         LeaveType
  startDate    DateTime    @map("start_date") @db.Date
  endDate      DateTime    @map("end_date") @db.Date
  /// Working days (Monday–Friday) counted at request time.
  days         Int
  reason       String?
  status       LeaveStatus @default(REQUESTED)
  requestedBy  String      @map("requested_by") @db.Uuid
  decidedBy    String?     @map("decided_by") @db.Uuid
  decidedAt    DateTime?   @map("decided_at") @db.Timestamptz(6)
  decisionNote String?     @map("decision_note")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  staff Staff @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, staffId])
  @@map("leave_requests")
}

/// Days of paid annual leave granted for a calendar year.
model LeaveEntitlement {
  tenantId String @map("tenant_id") @db.Uuid
  staffId  String @map("staff_id") @db.Uuid
  year     Int
  days     Int

  staff Staff @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, staffId, year])
  @@map("leave_entitlements")
}

enum Audience {
  ALL
  STAFF
  GUARDIANS
  STUDENTS
  CLASS
}

/// School announcement targeted by audience (COM-002/003). Contains no per-student data.
model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  title       String
  body        String
  audience    Audience
  classId     String?   @map("class_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  publishedAt DateTime  @default(now()) @map("published_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)

  @@index([tenantId, publishedAt])
  @@map("announcements")
}

/// One message to one user, in-app, with read status (COM-004/005).
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String
  title     String
  body      String
  link      String?
  /// Idempotency of automatic notifications (e.g. one absence alert per student and day).
  dedupeKey String?   @map("dedupe_key")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  deliveries NotificationDelivery[]

  @@unique([tenantId, userId, dedupeKey])
  @@unique([tenantId, id])
  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

enum DeliveryChannel {
  EMAIL
  SMS
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

/// External delivery attempt (email/SMS); creation is distinct from delivery (COM AC), failures are retryable.
model NotificationDelivery {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  notificationId String          @map("notification_id") @db.Uuid
  channel        DeliveryChannel
  destination    String
  status         DeliveryStatus  @default(PENDING)
  attempts       Int             @default(0)
  lastError      String?         @map("last_error")
  sentAt         DateTime?       @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [tenantId, notificationId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("notification_deliveries")
}
